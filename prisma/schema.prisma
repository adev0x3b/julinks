// JuLinks data model: users, their links, the clicks those links receive, and themes.
// Images (avatars, link thumbnails, theme backgrounds) live in object storage; rows keep the key.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String
  bio          String   @default("")
  avatarKey    String?
  /// Focal point of the avatar inside its circle, in percent of the picture (50/50 = centre).
  avatarFocusX Int      @default(50)
  avatarFocusY Int      @default(50)
  /// The theme shown on the public page; null falls back to the default preset.
  themeId      String?
  /// Sign-ups are requests: an admin or moderator approves or denies them before the account can log in.
  status       AccountStatus @default(pending)
  /// What the account may do once approved. The admin is created at /setup with the code the migrate step prints.
  role         Role     @default(client)
  /// Seeded demo profiles (/ada, /grace): never admins, never listed as requests, and a site with only them is still "not set up".
  isDemo       Boolean  @default(false)
  /// Stamped into session tokens; a password change bumps it, which logs every other device out.
  sessionVersion Int    @default(0)
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  links        Link[]
  folders      Folder[]
  socials      SocialLink[]
  theme        Theme?   @relation("activeTheme", fields: [themeId], references: [id], onDelete: SetNull)
  themes       Theme[]  @relation("ownedThemes")
  passwordResets PasswordReset[]

  @@map("users")
}

/// A group of links on the public page: shown as a titled section, or as a row that expands when collapsed.
model Folder {
  id        String   @id @default(cuid())
  userId    String
  title     String
  position  Int
  collapsed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     Link[]

  @@index([userId, position])
  @@map("folders")
}

/// The icon row under the bio: a platform, what the owner typed (handle, address or URL) and the URL it opens.
model SocialLink {
  id       String @id @default(cuid())
  userId   String
  platform String
  value    String
  url      String
  position Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("social_links")
}

model Link {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  position  Int
  enabled   Boolean  @default(true)
  thumbnailKey String?
  /// How the picture shows on the public page: a small thumbnail beside the title, or a big card image above it.
  imageLayout  ImageLayout @default(thumbnail)
  /// Focal point of the picture inside its frame, in percent (50/50 = centre).
  imageFocusX  Int      @default(50)
  imageFocusY  Int      @default(50)
  /// The folder this link sits in on the public page; null means the top-level list.
  folderId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  clicks    Click[]

  @@index([userId, position])
  @@index([folderId])
  @@map("links")
}

enum ImageLayout {
  thumbnail
  featured
}

enum AccountStatus {
  pending
  approved
  denied
}

enum Role {
  client
  moderator
  admin
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  referrer  String?
  createdAt DateTime @default(now())
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@map("clicks")
}

/// A user's theme: design tokens as JSON (see src/lib/themes.ts) plus an optional
/// background image. Applying someone else's public theme copies it, so every
/// theme has exactly one owner and editing or deleting it affects nobody else.
model Theme {
  id            String    @id @default(cuid())
  ownerId       String
  name          String
  tokens        Json
  backgroundKey String?
  isPublic      Boolean   @default(false)
  publishedAt   DateTime?
  /// The public theme this one was copied from, for attribution in the studio.
  forkedFromId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  owner         User      @relation("ownedThemes", fields: [ownerId], references: [id], onDelete: Cascade)
  usedBy        User[]    @relation("activeTheme")

  @@index([ownerId, updatedAt])
  @@index([isPublic, publishedAt])
  @@map("themes")
}

/// The one-time code that creates the admin account on a fresh install (src/lib/data/setup.ts).
/// One row at most; only the bcrypt hash is stored, the plain code is printed by the migrate step.
model SetupCode {
  id        Int      @id
  codeHash  String
  /// Wrong guesses so far; the code stops working after MAX_SETUP_ATTEMPTS.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("setup_codes")
}

/// Mail waiting to go out, and the record of what went (src/lib/mail/outbox.ts). Every message is a row
/// first; a loop in the app sends rows while the daily and hourly budgets allow, so nothing is lost to a
/// restart or a spent quota. Sent rows are what the budget is counted from.
model MailOutbox {
  id             String     @id @default(cuid())
  /// "admin-requests" (built when it is sent, from the requests waiting then) or "decision".
  kind           String
  /// Empty for an admin notice: the recipients are the admins at send time.
  recipients     String[]
  subject        String     @default("")
  text           String     @default("")
  html           String     @default("")
  status         MailStatus @default(queued)
  attempts       Int        @default(0)
  /// Not sent before this time: the admin notice's half-hour spacing, or a retry's backoff.
  notBefore      DateTime   @default(now())
  /// How many addresses the message went to: what the provider's quota counts.
  recipientCount Int        @default(0)
  lastError      String?
  createdAt      DateTime   @default(now())
  sentAt         DateTime?

  @@index([status, notBefore])
  @@index([sentAt])
  @@map("mail_outbox")
}

enum MailStatus {
  queued
  sending
  sent
  failed
}

/// A "forgot password" link: only the SHA-256 of its token is kept. One use, short-lived.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  /// Set when the link is used, or when another password change makes it pointless.
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}
