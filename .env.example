# Copy to .env for local development. docker compose sets its own values.
DATABASE_URL="postgresql://julinks:julinks@localhost:5432/julinks"
# At least 32 characters. Sessions are signed with it; rotating it logs everyone out.
SESSION_SECRET="change-me-to-a-long-random-string-32chars"
# Where the app is reachable, for absolute URLs in page metadata (og:image).
APP_URL="http://localhost:3000"
# Only for tests: lets "grab from the link" fetch servers on 127.0.0.1. Never set it in production.
# LINK_PREVIEW_ALLOW_PRIVATE="1"

# --- Switches for a public deployment (all optional; the defaults suit a laptop) ---
# The seeded demo profiles (ada, grace) have published passwords. Set 0 on a public site so nobody
# can log in as them and rewrite the showcase pages. They stay visible at /ada and /grace.
# ALLOW_DEMO_LOGIN="0"
# Behind a reverse proxy that appends the client address to X-Forwarded-For (nginx with
# proxy_add_x_forwarded_for, Caddy, Traefik), set 1 so the per-IP rate limits key on the real address.
# Leave unset when browsers connect to the app directly.
# TRUST_PROXY="1"
# The first real sign-up on an empty database becomes the admin. On a public site, name the email that
# may claim that seat; every other first sign-up waits as a request until that address has registered.
# FIRST_ADMIN_EMAIL="you@example.com"

# Object storage (S3 API). `docker compose up s3` gives you one locally (SeaweedFS on 8333); for tests without
# Docker, `npx tsx scripts/fake-s3.ts 3101` runs an in-memory stand-in on http://127.0.0.1:3101.
S3_ENDPOINT="http://127.0.0.1:8333"
S3_BUCKET="julinks"
S3_ACCESS_KEY_ID="julinks"
S3_SECRET_ACCESS_KEY="julinks-secret"
# S3_REGION="us-east-1"           # default
# S3_FORCE_PATH_STYLE="true"      # default; set to false for AWS-style virtual-host buckets
