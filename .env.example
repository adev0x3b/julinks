# Copy to .env: docker compose reads SESSION_SECRET, APP_URL, WEB_PORT, WEB_BIND, the S3 keys and the
# switches below from it; `npm run dev` reads everything.
DATABASE_URL="postgresql://julinks:julinks@localhost:5432/julinks"
# Sessions are signed with it (at least 32 characters; rotating it logs everyone out). This placeholder
# only works while APP_URL is localhost: for anything reachable from outside, paste `openssl rand -base64 48`.
SESSION_SECRET="change-me-to-a-long-random-string-32chars"
# Where the app is reachable, for absolute URLs in page metadata (og:image) and the secret check above.
APP_URL="http://localhost:3000"
# docker compose publishes the web port on this address. 127.0.0.1 keeps it off the LAN (a tunnel or
# reverse proxy on the same machine still reaches it); 0.0.0.0 publishes it to every interface.
# WEB_BIND="127.0.0.1"
# WEB_PORT="3000"
# Only for tests: lets "grab from the link" fetch servers on 127.0.0.1. Never set it in production.
# LINK_PREVIEW_ALLOW_PRIVATE="1"

# --- Switches for a public deployment (all optional; the defaults suit a local environment) ---
# The seeded demo profiles (ada, grace) have published passwords. Set 0 on a public site so nobody
# can log in as them and rewrite the showcase pages. They stay visible at /ada and /grace.
# ALLOW_DEMO_LOGIN="0"
# Which header carries the visitor's address, for the per-IP rate limits. "cloudflare" behind a Cloudflare
# Tunnel or proxied record (cf-connecting-ip); "1" behind nginx (proxy_add_x_forwarded_for), Caddy or
# Traefik (last X-Forwarded-For entry). Leave unset when browsers connect to the app directly.
# TRUST_PROXY="cloudflare"

# --- Mail (optional): the admins hear about sign-up requests, requesters about the decision ---
# Without SMTP_HOST nothing is sent and the app logs what it would have sent. STARTTLS is required
# unless SMTP_TLS="none" (only for a local catcher such as Mailpit). MAIL_FROM must be an address the
# relay lets this login send as.
# SMTP_HOST="mail.example.com"
# SMTP_PORT="587"
# SMTP_USER="julinks"
# SMTP_PASSWORD=""
# MAIL_FROM="JuLinks <noreply@example.com>"
# Addresses mailed per rolling 24 hours and per hour; whatever does not fit waits in the outbox.
# MAIL_DAILY_LIMIT="50"
# MAIL_HOURLY_LIMIT="10"
# A relay in another compose project on this machine: join its Docker network (docker-compose.mail.yml).
# COMPOSE_FILE="docker-compose.yml:docker-compose.mail.yml"
# MAIL_NETWORK="jumail"

# Object storage (S3 API). `docker compose up s3` gives you one locally (SeaweedFS on 8333); for tests without
# Docker, `npx tsx scripts/fake-s3.ts 3101` runs an in-memory stand-in on http://127.0.0.1:3101.
S3_ENDPOINT="http://127.0.0.1:8333"
S3_BUCKET="julinks"
S3_ACCESS_KEY_ID="julinks"
S3_SECRET_ACCESS_KEY="julinks-secret"
# S3_REGION="us-east-1"           # default
# S3_FORCE_PATH_STYLE="true"      # default; set to false for AWS-style virtual-host buckets
